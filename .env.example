# Copie para ".env" (NÃO versionar) e troque os valores.
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
# >= 32 caracteres. Mesma chave no auth-api (assina) e gateway-api (valida) — ambos recebem do Consul KV.
JWT_SECRET=troque-por-uma-chave-aleatoria-com-32+-caracteres
# Senha do usuário administrador (admin@admin.dev), criado na 1ª execução do auth-api
ADMIN_PASSWORD=troque-esta-senha
GRAFANA_PASSWORD=troque-esta-senha
