<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <springProperty scope="context" name="app" source="spring.application.name"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Logs centralizados: envia para o Loki quando o perfil "docker" estiver ativo (LOKI_URL) -->
    <springProfile name="docker">
        <springProperty scope="context" name="lokiUrl" source="LOKI_URL" defaultValue="http://loki:3100/loki/api/v1/push"/>
        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <batchTimeoutMs>3000</batchTimeoutMs>
            <http>
                <url>${lokiUrl}</url>
            </http>
            <format>
                <label>
                    <pattern>app=${app},host=${HOSTNAME},level=%level</pattern>
                </label>
                <message>
                    <pattern>${FILE_LOG_PATTERN}</pattern>
                </message>
            </format>
        </appender>
        <root level="INFO">
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>
</configuration>
